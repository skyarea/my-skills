#!/bin/sh
# Generated by project-scaffold. Re-run generator to upgrade.
protected=" {{BRANCH_MAIN}} {{BRANCH_DEVELOP}} "
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "HEAD")

case "$branch" in
  {{BRANCH_MAIN}}|{{BRANCH_DEVELOP}}|feature/*|release/*|hotfix/*|HEAD) ;;
  *) printf '[pre-push] WARN: branch %s is not a GitFlow name.\n' "$branch" >&2 ;;
esac

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -n "$remote_ref" ] || continue
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  target=${remote_ref#refs/heads/}
  if printf '%s' "$protected" | grep -q " $target "; then
    echo "[pre-push] Rejected: direct push to protected branch '$target'." >&2
    echo "  GitFlow: {{BRANCH_MAIN}} + {{BRANCH_DEVELOP}} accept merges only." >&2
    echo "  Use: git checkout {{BRANCH_DEVELOP}} && git checkout -b feature/<name>" >&2
    echo "  For intentional bootstrap, use --no-verify and state why in the PR." >&2
    exit 1
  fi
done
exit 0
