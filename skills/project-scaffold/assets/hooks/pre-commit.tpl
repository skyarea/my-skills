#!/bin/sh
# Generated by project-scaffold. Re-run generator to upgrade.
repo_root=$(git rev-parse --show-toplevel) || exit 1
validator="$repo_root/.scaffold/scaffold.js"
if command -v node >/dev/null 2>&1; then
  node "$validator" validate "$repo_root"
else
  echo "[pre-commit] node missing; doc check skipped (install Node to enforce)." >&2
fi
exit $?
