#!/bin/sh
# Generated by project-scaffold. Re-run generator to upgrade.
msg_file="$1"
subject=$(head -n 1 "$msg_file")

# Skip merge/revert commits generated by git itself
case "$subject" in
  Merge\ *|Revert\ *|fixup\!*|squash\!*) exit 0 ;;
esac

pattern='^(feat|fix|docs|refactor|test|chore|perf|build|ci|style|revert)(\([a-zA-Z0-9._/-]+\))?(!)?: .+'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "[commit-msg] 格式不合规: $subject" >&2
  echo "期望: <type>(<scope>): <subject>" >&2
  echo "type: feat|fix|docs|refactor|test|chore|perf|build|ci|style|revert" >&2
  exit 1
fi
exit 0
